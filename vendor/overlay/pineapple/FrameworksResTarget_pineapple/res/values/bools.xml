<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Whether the device offers always-on display in Doze. -->
    <bool name="config_dozeAlwaysOnDisplayAvailable">true</bool>

    <!-- Initial always-on display setting when the user has no saved preference. -->
    <bool name="config_dozeAlwaysOnEnabled">false</bool>

    <!-- Allow the application processor to autosuspend while the display is on. -->
    <bool name="config_powerDecoupleAutoSuspendModeFromDisplay">true</bool>

    <!-- Show the software navigation bar. -->
    <bool name="config_showNavigationBar">true</bool>

    <!-- Detect headset jack switch changes through Linux /dev/input/event. -->
    <bool name="config_useDevInputEventForAudioJack">true</bool>

    <!-- Expose legacy dual-band Soft AP support to hotspot settings. -->
    <bool name="config_wifi_dual_sap_mode_enabled">false</bool>
</resources>
